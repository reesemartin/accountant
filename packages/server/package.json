{
  "name": "@accountant/server",
  "license": "MIT",
  "version": "1.0.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "NODE_ENV=production nest build",
    "depcheck": "depcheck .",
    "dev": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 nest start --watch | pino-pretty",
    "dev:debug": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 nest start --debug --watch | pino-pretty",
    "start:prod": "NODE_ENV=production node dist/main",
    "test": "TZ=UTC NODE_ENV=test jest",
    "test:cov": "jest --coverage",
    "test:integration": "TZ=UTC NODE_ENV=test jest --testPathIgnorePatterns='/node_modules/' --testMatch='**/*.integration.test.ts'",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^3.5.0",
    "@fastify/static": "^6.12.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/websockets": "^10.3.0",
    "@netlify/functions": "^2.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.10",
    "fastify": "^4.25.2",
    "firebase-admin": "^12.0.0",
    "nanoid": "^5.0.4",
    "nestjs-pino": "^3.5.0",
    "pino": "^8.17.2",
    "pino-http": "^9.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "ts-dotenv": "^0.9.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@swc/core": "^1.3.102",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "copy-webpack-plugin": "^11.0.0",
    "depcheck": "^1.4.7",
    "jest": "^29.7.0",
    "mockdate": "^3.0.5",
    "node-loader": "^2.0.0",
    "pino-pretty": "^10.3.1",
    "swc-loader": "^0.2.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "webpack": "5.97.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}"
    ],
    "coverageDirectory": "coverage",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx"
    ],
    "preset": "ts-jest",
    "roots": [
      "."
    ],
    "setupFiles": [
      "./../../jest.env.setup.js"
    ],
    "setupFilesAfterEnv": [
      "./src/jestSetup.ts"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.+(ts|tsx|js)",
      "**/?(*.)+(spec|test).+(ts|tsx|js)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.test\\.ts$"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "decorators": true,
              "dynamicImport": true,
              "syntax": "typescript",
              "tsx": true
            },
            "transform": {
              "decoratorMetadata": true,
              "legacyDecorator": true
            },
            "target": "es2022"
          },
          "module": {
            "type": "es6"
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!nanoid).+\\.(js|jsx|ts|tsx)$"
    ]
  }
}
